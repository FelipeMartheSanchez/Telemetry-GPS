NOMBRE_PAGINA=GPS Telemetry - Your name
DB_HOST=rds_endpoint
DB_PORT=3306
DB_USER=your_user
DB_PASSWORD=your_password
DB_NAME=db_your_name
UDP_PORT=5000
WEB_PORT=8000

# Origen de la ubicacion del Auto 1 (si no esta: esp32)
#   esp32    -> la ESP32 envia ubicacion, estilo y eventos, y abre/cierra el viaje
#   emulador -> la ruta y el viaje vienen del emulador; de la ESP32 solo estilo y eventos
UBICACION_DESDE=esp32
# Emulador del Auto 1 en /emulador (solo en UNA instancia de dev)
EMULADOR=0
