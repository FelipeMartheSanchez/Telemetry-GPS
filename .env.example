NOMBRE_PAGINA=GPS Telemetry - Your name
DB_HOST=rds_endpoint
DB_PORT=3306
DB_USER=your_user
DB_PASSWORD=your_password
DB_NAME=db_your_name
UDP_PORT=5000
WEB_PORT=8000

# Origen de la ubicacion del Auto 1 (recomendado dejar 'esp32': /emulador
# activa el modo hibrido automaticamente durante cada viaje y al terminar vuelve solo)
UBICACION_DESDE=esp32
# Emulador del Auto 1 en /emulador (solo en la instancia donde se vaya a usar)
EMULADOR=0
# Clave requerida para entrar a /emulador (vacio = acceso bloqueado)
EMULADOR_CLAVE=
